{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hayaoshi-quiz-royale",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  // public/ の画面ファイルはそのまま配信し、/ws だけ Worker が受け付ける
  "assets": {
    "directory": "./public"
  },
  // 部屋1つにつき Durable Object が1つ。早押しの判定はここで行う
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
